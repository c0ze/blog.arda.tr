---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { render } from 'astro:content';
import { getPublishedPosts, getSlug } from '@/lib/posts';
import { ledgerNo, readingTimeMinutes, formatDateShort, minuteBars } from '@/lib/display';
import TagChip from '@/components/TagChip.astro';
import FileRow from '@/components/FileRow.astro';
import OgCanvas from '@/components/OgCanvas.astro';

export async function getStaticPaths() {
  const sortedPosts = await getPublishedPosts();

  return sortedPosts.map((post, index) => {
    // Extract the filename without extensions and without the year parent directory for the slug
    const slug = getSlug(post);

    // Up to 3 related posts, scored by shared-tag count with recency as the
    // tie-break (sortedPosts is newest-first, so a lower index is more recent).
    // Drafts are already excluded by getPublishedPosts(). Build-time only.
    const tags = new Set(post.data.tags);
    const related = sortedPosts
      .map((candidate, candidateIndex) => ({
        candidate,
        candidateIndex,
        shared: candidate.data.tags.filter((tag) => tags.has(tag)).length,
      }))
      .filter(({ candidate, shared }) => candidate.id !== post.id && shared > 0)
      .sort((a, b) => b.shared - a.shared || a.candidateIndex - b.candidateIndex)
      .slice(0, 3)
      .map(({ candidate, candidateIndex }) => ({
        post: candidate,
        no: ledgerNo(candidateIndex, sortedPosts.length),
      }));

    return {
      params: { slug },
      props: {
        post,
        no: ledgerNo(index, sortedPosts.length),
        prevPost: sortedPosts[index + 1] || null,
        nextPost: sortedPosts[index - 1] || null,
        related,
      },
    };
  });
}

const { post, no, prevPost, nextPost, related } = Astro.props;
const { Content } = await render(post);

const minutes = readingTimeMinutes(post.body);
const slug = getSlug(post);

// Determine OG image - use post image if available, otherwise default
const ogImage = post.data.image || '/images/og-image.jpg';
const ogImageAbsolute = new URL(ogImage, Astro.site).href;
---

<BaseLayout
  title={`${post.data.title} - Coze`}
  description={post.data.description || post.data.excerpt}
  image={ogImage}
  keywords={post.data.keywords}
  type="article"
  publishedTime={post.data.date.toISOString()}
  lang={post.data.lang}
>
  <!-- data-pagefind-body scopes the Pagefind search index to post content:
       once any page declares it, pages without it (home, listings) are skipped. -->
  <article class="post" data-pagefind-body>
    <header class="post__col">
      <a class="post__back" href="/blog" lang="en" data-pagefind-ignore>◂ back to the ledger</a>

      <div class="post__meta" lang="en">
        <span class="sig">{no}</span>
        <time datetime={post.data.date.toISOString()}>{formatDateShort(post.data.date)}</time>
        <span title={`${minutes} minute read`}>{minutes} min<span class="bars" aria-hidden="true" data-pagefind-ignore>{minuteBars(minutes)}</span></span>
        {post.data.author && <span class="post__author">{post.data.author}</span>}
      </div>

      <h1>{post.data.title}</h1>

      {post.data.tags.length > 0 && (
        <ul class="chips" lang="en" aria-label="Tags">
          {post.data.tags.map((tag) => <li><TagChip tag={tag} /></li>)}
        </ul>
      )}

      {post.data.excerpt && (
        <div class="excerpt">
          <span lang="en" data-pagefind-ignore>excerpt</span>
          <p>{post.data.excerpt}</p>
        </div>
      )}
    </header>

    <!-- The cover: the post's OG image develops as 1-bit, then the dither burns off to the real image
         (a seeded sigil, which stays 1-bit, when it has none). -->
    <OgCanvas
      src={post.data.image}
      seed={slug}
      alt={`Cover image: ${post.data.title}`}
      px={2}
      contrast={1.3}
      class="post__hero"
      reveal
    />

    <!-- The reading column: Plex Serif at a 68ch measure. Media, code and
         tables are not prose and take the column. -->
    <div class="post__col post__body prose">
      <Content />
    </div>

    <div class="after" lang="en">
      <!-- Related entries: shared-tag neighbours, resolved at build time.
           data-pagefind-ignore keeps their titles out of this page's search record. -->
      {related.length > 0 && (
        <section aria-labelledby="related-heading" data-pagefind-ignore>
          <h2 id="related-heading" class="sec-h"><b>related entries</b><span>shared tags</span></h2>
          <div class="ls">
            {related.map(({ post: rel, no: relNo }) => (
              <FileRow
                slug={getSlug(rel)}
                title={rel.data.title}
                date={rel.data.date}
                tags={rel.data.tags}
                no={relNo}
                minutes={readingTimeMinutes(rel.body)}
                lang={rel.data.lang}
                image={rel.data.image}
              />
            ))}
          </div>
        </section>
      )}

      <!-- Prev / next. -->
      <nav class="postnav" aria-label="Adjacent posts" data-pagefind-ignore>
        {prevPost && (
          <a href={`/blog/${getSlug(prevPost)}`}>
            <span>◂ previous entry</span>
            <strong lang={prevPost.data.lang ?? 'en'}>{prevPost.data.title}</strong>
          </a>
        )}
        {nextPost && (
          <a class="postnav__next" href={`/blog/${getSlug(nextPost)}`}>
            <span>next entry ▸</span>
            <strong lang={nextPost.data.lang ?? 'en'}>{nextPost.data.title}</strong>
          </a>
        )}
      </nav>
    </div>
  </article>

  <!-- JSON-LD Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": post.data.title,
    "description": post.data.description || post.data.excerpt,
    "datePublished": post.data.date.toISOString(),
    "dateModified": post.data.date.toISOString(),
    "image": ogImageAbsolute,
    "author": {
      "@type": "Person",
      "name": post.data.author || "Arda Karaduman",
      "url": "https://arda.tr"
    },
    "publisher": {
      "@type": "Person",
      "name": "Coze"
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": `https://blog.arda.tr/blog/${slug}`
    },
    "keywords": post.data.keywords
  })} />
</BaseLayout>
