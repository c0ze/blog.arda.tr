---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { render } from 'astro:content';
import { getPublishedPosts, getSlug } from '@/lib/posts';
import { OWNER, blogPostingLd, bodyDescription, isPlainTitle, jsonLd, ledgerNo, readingTimeMinutes, formatDateShort, postHref, roman, summary } from '@/lib/display';
import wisp from '@/brand/art/wisp.webp';
import TagChip from '@/components/TagChip.astro';
import EntryRow from '@/components/EntryRow.astro';

export async function getStaticPaths() {
  const sortedPosts = await getPublishedPosts();

  return sortedPosts.map((post, index) => {
    // Extract the filename without extensions and without the year parent directory for the slug
    const slug = getSlug(post);

    // Up to 3 related posts, scored by shared-tag count with recency as the
    // tie-break (sortedPosts is newest-first, so a lower index is more recent).
    // Drafts are already excluded by getPublishedPosts(). Build-time only.
    const tags = new Set(post.data.tags);
    const related = sortedPosts
      .map((candidate, candidateIndex) => ({
        candidate,
        candidateIndex,
        shared: candidate.data.tags.filter((tag) => tags.has(tag)).length,
      }))
      .filter(({ candidate, shared }) => candidate.id !== post.id && shared > 0)
      .sort((a, b) => b.shared - a.shared || a.candidateIndex - b.candidateIndex)
      .slice(0, 3)
      .map(({ candidate, candidateIndex }) => ({
        post: candidate,
        no: ledgerNo(candidateIndex, sortedPosts.length),
      }));

    return {
      params: { slug },
      props: {
        post,
        no: ledgerNo(index, sortedPosts.length),
        // older and newer neighbours, each with its number
        prevPost: sortedPosts[index + 1] ? { post: sortedPosts[index + 1], no: ledgerNo(index + 1, sortedPosts.length) } : null,
        nextPost: sortedPosts[index - 1] ? { post: sortedPosts[index - 1], no: ledgerNo(index - 1, sortedPosts.length) } : null,
        related,
      },
    };
  });
}

const { post, no, prevPost, nextPost, related } = Astro.props;
const { Content } = await render(post);

const minutes = readingTimeMinutes(post.body);
const slug = getSlug(post);
// Legacy posts have neither description nor excerpt: summarise the body, else
// the layout's default description.
const description = post.data.description || post.data.excerpt || bodyDescription(post.body) || undefined;

// Determine OG image - use post image if available, otherwise default.
// It is only a meta tag: the page itself opens with number, date, title.
const ogImage = post.data.image || '/images/og-image.jpg';
const ogImageAbsolute = new URL(ogImage, Astro.site).href;

const standfirst = summary(post.data);
// A post by someone else (the Gemmy bot post) keeps its byline in the meta line.
const guestAuthor = post.data.author && post.data.author !== OWNER ? post.data.author : undefined;
---

<BaseLayout
  title={`${post.data.title} - Coze`}
  description={description}
  image={ogImage}
  keywords={post.data.keywords}
  type="article"
  publishedTime={post.data.date.toISOString()}
  lang={post.data.lang}
>
  <!-- data-pagefind-body scopes the Pagefind search index to post content:
       once any page declares it, pages without it (home, listings) are skipped. -->
  <article class="post" data-pagefind-body>
    <!-- A post opens with number, date and reading time, then the title: no
         hero image. The meta line stays out of the search index; only the
         title and body count. -->
    <header class="post-head">
      <p class="ix-mono" lang="en" data-pagefind-ignore>
        <span aria-hidden="true">{roman(no)}</span><span class="ix-sr">Post {no}</span> ·
        <time datetime={post.data.date.toISOString()}>{formatDateShort(post.data.date)}</time> ·
        {minutes} min read{guestAuthor && ` · ${guestAuthor}`}
      </p>

      <!-- Blackletter for a name; Spectral for a long title or a Japanese one. -->
      <h1 class:list={['ix-emerge', { 'title-plain': isPlainTitle(post.data.title, post.data.lang) }]}>{post.data.title}</h1>

      {standfirst && <p class="ix-lede ix-muted">{standfirst}</p>}
    </header>

    <!-- The one piece of artwork: a wisp on a soot plate in the right margin,
         wide screens only (global.css). Decoration: empty alt, lazy, so a
         phone never fetches it. -->
    <div class="ix-plate ix-smoke post-wisp" data-pagefind-ignore>
      <img class="ix-art ix-art--drift" data-smoke-video="/brand/wisp-smoke.mp4" alt="" src={wisp.src} width={wisp.width} height={wisp.height} loading="lazy" decoding="async" />
    </div>

    <!-- The reading column. -->
    <div class="ix-prose post-body">
      <Content />
    </div>

    <!-- data-pagefind-ignore keeps tags, related titles and prev/next out of
         this page's search record. -->
    <footer class="post-foot" lang="en" data-pagefind-ignore>
      {post.data.tags.length > 0 && (
        <ul class="ix-chips block" aria-label="Tags">
          {post.data.tags.map((tag) => <li><TagChip tag={tag} moss /></li>)}
        </ul>
      )}

      <!-- Related posts: shared-tag neighbours, resolved at build time. -->
      {related.length > 0 && (
        <section class="block">
          <div class="list-head">
            <h2 class="ix-label ix-label--ember">Related posts</h2>
            <span class="ix-label">shared tags</span>
          </div>
          <ul class="ix-list">
            {related.map(({ post: rel, no: relNo }) => (
              <EntryRow
                slug={getSlug(rel)}
                title={rel.data.title}
                date={rel.data.date}
                tags={rel.data.tags}
                no={relNo}
                lang={rel.data.lang}
              />
            ))}
          </ul>
        </section>
      )}

      <!-- The older and the newer neighbour, as key and value; then all posts. -->
      <nav class="block" aria-label="More posts">
        <dl class="ix-kv">
          {prevPost && (
            <div>
              <dt>Older</dt>
              <dd><a rel="prev" href={postHref(getSlug(prevPost.post))}><span aria-hidden="true">{roman(prevPost.no)}: </span><span lang={prevPost.post.data.lang ?? 'en'}>{prevPost.post.data.title}</span></a></dd>
            </div>
          )}
          {nextPost && (
            <div>
              <dt>Newer</dt>
              <dd><a rel="next" href={postHref(getSlug(nextPost.post))}><span aria-hidden="true">{roman(nextPost.no)}: </span><span lang={nextPost.post.data.lang ?? 'en'}>{nextPost.post.data.title}</span></a></dd>
            </div>
          )}
        </dl>
        <p class="more"><a href="/blog/">All posts</a></p>
      </nav>
    </footer>
  </article>

  <!-- JSON-LD Schema -->
  <script type="application/ld+json" is:inline set:html={jsonLd(blogPostingLd(post.data, {
    url: new URL(postHref(slug), Astro.site).href,
    description,
    image: ogImageAbsolute,
  }))} />

  <!-- The wisp moves: the family's smoke.js plays its film over the image. -->
  <script>
    import { startSmoke } from '@/brand/smoke.js';
    startSmoke();
  </script>
</BaseLayout>
