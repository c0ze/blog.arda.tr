---
import BaseLayout from '@/layouts/BaseLayout.astro';
import EntryRow from '@/components/EntryRow.astro';
import { getLedger } from '@/lib/ledger';
import { summary } from '@/lib/display';

const { entries, total, tags, firstYear, lastYear } = await getLedger();
const allTags = [...tags].sort((a, b) => a.tag.localeCompare(b.tag));
---

<BaseLayout title="Entries - Coze" description="Every post on Coze, listed newest first and filterable by tag.">
  <header class="page-head" lang="en">
    <h1>Blog</h1>
    <p class="ix-lede">Every post, newest first.</p>
  </header>

  <div lang="en">
    <!-- The filter: the tag chips are the control. Deep-linked from anywhere on
         the site as /blog/?tag=dev; with no script it is simply the full list. -->
    <div class="filter">
      <p class="ix-small ix-muted">Filter by tag: <b id="tag-now">all</b></p>
      <!-- Phones only (global.css): the script shows this toggle and collapses the
           chips to the active one. Without script every chip stays visible. -->
      <button type="button" class="ix-chip tag-toggle" id="tag-toggle" aria-controls="tag-filters" aria-expanded="false" hidden>Tags <span id="tag-toggle-arrow" aria-hidden="true">▾</span><span class="chip-n" id="tag-toggle-now" hidden></span></button>
      <div class="ix-chips" id="tag-filters" role="group" aria-label="Filter posts by tag">
        <button type="button" class="ix-chip" data-tag="all" aria-pressed="true">All <span class="chip-n">{total}</span></button>
        {allTags.map(({ tag, count }) => (
          <button type="button" class="ix-chip" data-tag={tag} aria-pressed="false">{tag} <span class="chip-n">{count}</span></button>
        ))}
      </div>
    </div>

    <div class="list-head">
      <h2 class="ix-label ix-label--ember">Posts</h2>
      <span class="ix-label">{firstYear} – {lastYear}</span>
    </div>
    <ul class="ix-list" id="posts-list">
      {entries.map((entry) => (
        <EntryRow
          slug={entry.slug}
          title={entry.post.data.title}
          date={entry.date}
          tags={entry.post.data.tags}
          no={entry.no}
          lang={entry.post.data.lang}
          desc={summary(entry.post.data)}
        />
      ))}
    </ul>

    <p id="no-results" class="ix-note empty" hidden>
      <b>0 entries</b>: no posts match that tag.
    </p>
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    var buttons = document.querySelectorAll('#tag-filters .ix-chip');
    var list = document.getElementById('posts-list');
    var rows = list ? list.querySelectorAll('.ix-row') : [];
    var empty = document.getElementById('no-results');
    var now = document.getElementById('tag-now');
    var filters = document.getElementById('tag-filters');
    var toggle = document.getElementById('tag-toggle');
    var toggleArrow = document.getElementById('tag-toggle-arrow');
    var toggleNow = document.getElementById('tag-toggle-now');
    if (!list) return;

    // Phones: the chips collapse behind the toggle, leaving the active chip.
    // data-collapsed only takes effect under the ≤640px rule in global.css.
    function setOpen(open) {
      if (!filters || !toggle) return;
      filters.setAttribute('data-collapsed', String(!open));
      toggle.setAttribute('aria-expanded', String(open));
      if (toggleArrow) toggleArrow.textContent = open ? '▴' : '▾';
    }

    function applyFilter(tag, updateUrl) {
      buttons.forEach(function (btn) {
        btn.setAttribute('aria-pressed', String(btn.getAttribute('data-tag') === tag));
      });

      var visible = 0;
      rows.forEach(function (row) {
        var rowTags = (row.getAttribute('data-tags') || '').split(',');
        var show = tag === 'all' || rowTags.indexOf(tag) !== -1;
        row.hidden = !show;
        if (show) visible++;
      });
      if (empty) empty.hidden = visible > 0;
      if (now) now.textContent = tag;
      if (toggleNow) {
        toggleNow.textContent = tag === 'all' ? '' : tag;
        toggleNow.hidden = tag === 'all';
      }

      if (updateUrl) {
        var url = new URL(window.location.href);
        if (tag === 'all') url.searchParams.delete('tag');
        else url.searchParams.set('tag', tag);
        history.replaceState(null, '', url);
      }
    }

    buttons.forEach(function (button) {
      button.addEventListener('click', function () {
        var tag = button.getAttribute('data-tag');
        if (tag !== null) applyFilter(tag, true);
        setOpen(false);
        // On phones the collapsed chips hide "All": keep focus on the page
        // instead of letting it fall to <body> with the vanished chip.
        if (toggle && !button.getClientRects().length) toggle.focus();
      });
    });

    if (toggle) {
      toggle.hidden = false;
      toggle.addEventListener('click', function () {
        setOpen(toggle.getAttribute('aria-expanded') !== 'true');
      });
    }
    setOpen(false);

    // Deep-link support: a tag chip anywhere links to /blog/?tag=dev, landing pre-filtered.
    var requested = new URLSearchParams(window.location.search).get('tag');
    if (requested) {
      var known = false;
      buttons.forEach(function (b) { if (b.getAttribute('data-tag') === requested) known = true; });
      if (known) applyFilter(requested, false);
    }
  })();
</script>
