---
import BaseLayout from '@/layouts/BaseLayout.astro';
import FileRow from '@/components/FileRow.astro';
import { getLedger } from '@/lib/ledger';

const { entries, total, tags, firstYear, lastYear } = await getLedger();
const allTags = [...tags].sort((a, b) => a.tag.localeCompare(b.tag));
---

<BaseLayout title="Blog - Coze" description="All blog posts from Coze - Software Development Journey">
  <header class="phead" lang="en">
    <h1>Ledger</h1>
    <p class="phead__sub">every entry, newest first<br /><b>{total} entries</b> · {firstYear} — {lastYear}</p>
  </header>

  <div class="body" lang="en">
    <!-- The filter: the tag chips are the control. Deep-linked from anywhere on
         the site as /blog?tag=dev; with no script it is simply the full list. -->
    <p class="prompt">arda@coze:~$ <b>ls entries/ --tag=<span id="tag-now">*</span></b></p>
    <div class="chips chips--filter" id="tag-filters" role="group" aria-label="Filter entries by tag">
      <button type="button" class="chip" data-tag="all" aria-pressed="true">* <em>{total}</em></button>
      {allTags.map(({ tag, count }) => (
        <button type="button" class="chip" data-tag={tag} aria-pressed="false">{tag} <em>{count}</em></button>
      ))}
    </div>

    <div class="ls ls--no" id="posts-list">
      <div class="ls-head" aria-hidden="true"><span>cover</span><span>no</span><span>date</span><span>entry</span><span>min</span></div>
      {entries.map((entry) => (
        <FileRow
          slug={entry.slug}
          title={entry.post.data.title}
          date={entry.date}
          tags={entry.post.data.tags}
          no={entry.no}
          minutes={entry.minutes}
          lang={entry.post.data.lang}
          image={entry.post.data.image}
          showNo
        />
      ))}
    </div>

    <p id="no-results" class="empty" hidden>
      <b>№000</b> — no entries match that tag.
    </p>
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    var buttons = document.querySelectorAll('#tag-filters .chip');
    var list = document.getElementById('posts-list');
    var rows = list ? list.querySelectorAll('.file') : [];
    var empty = document.getElementById('no-results');
    var now = document.getElementById('tag-now');
    if (!list) return;

    function applyFilter(tag, updateUrl) {
      buttons.forEach(function (btn) {
        btn.setAttribute('aria-pressed', String(btn.getAttribute('data-tag') === tag));
      });

      var visible = 0;
      rows.forEach(function (row) {
        var rowTags = (row.getAttribute('data-tags') || '').split(',');
        var show = tag === 'all' || rowTags.indexOf(tag) !== -1;
        row.hidden = !show;
        if (show) visible++;
      });
      if (empty) empty.hidden = visible > 0;
      if (now) now.textContent = tag === 'all' ? '*' : tag;

      if (updateUrl) {
        var url = new URL(window.location.href);
        if (tag === 'all') url.searchParams.delete('tag');
        else url.searchParams.set('tag', tag);
        history.replaceState(null, '', url);
      }
    }

    buttons.forEach(function (button) {
      button.addEventListener('click', function () {
        var tag = button.getAttribute('data-tag');
        if (tag !== null) applyFilter(tag, true);
      });
    });

    // Deep-link support: a tag chip anywhere links to /blog?tag=dev, landing pre-filtered.
    var requested = new URLSearchParams(window.location.search).get('tag');
    if (requested) {
      var known = false;
      buttons.forEach(function (b) { if (b.getAttribute('data-tag') === requested) known = true; });
      if (known) applyFilter(requested, false);
    }
  })();
</script>
