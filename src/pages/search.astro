---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getLedger } from '@/lib/ledger';

// Full-text search over every post, powered by Pagefind. The index is
// generated at build time (`pagefind --site dist`, chained in `npm run build`),
// and the UI bundle is lazy-loaded only on this page.
const { total } = await getLedger();
---

<BaseLayout title="Search - Coze" description="Full-text search across every post on Coze.">
  <header class="page-head" lang="en">
    <h1>Search</h1>
    <p class="ix-lede">Full-text search.</p>
    <p class="ix-small ix-muted">{total} posts · post text only</p>
  </header>

  <div class="search-shell" lang="en">
    <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
    <div id="search"></div>
    <p id="search-unavailable" class="ix-small ix-muted note" hidden>
      <b>Search unavailable</b>: the search index only exists in production builds. Run
      <code>npm run build</code> and preview <code>dist/</code> to test it locally.
    </p>
    <noscript>
      <p class="ix-small ix-muted note">
        <b>JavaScript required</b>: search runs in the browser. The
        <a href="/archive/">archive</a> lists every entry by year.
      </p>
    </noscript>
  </div>
</BaseLayout>

<!-- Lazy-load the Pagefind UI bundle. It searches through
     /pagefind-all/pagefind.js, which queries every per-language index. In `astro dev` the /pagefind/ bundle
     doesn't exist (it is generated after `astro build`), so on load failure we
     quietly swap in the explanation above instead of a broken widget. -->
<script is:inline define:vars={{ total }}>
  (function () {
    var script = document.createElement('script');
    script.src = '/pagefind/pagefind-ui.js';
    script.onload = function () {
      new PagefindUI({
        element: '#search',
        translations: { placeholder: 'Search all ' + total + ' entries' },
        // Every language index at once (en, ja, tr), ranked together; see
        // public/pagefind-all/pagefind.js.
        bundlePath: '/pagefind-all/',
        showImages: false,
        showSubResults: true,
        autofocus: true,
      });
    };
    script.onerror = function () {
      document.getElementById('search-unavailable').hidden = false;
    };
    document.head.appendChild(script);
  })();
</script>

<!-- Pagefind UI on the theme's tokens: the family's input (surface colour, a
     1px rule, 2px corners), messages as labels, a hairline between results,
     result titles as ember links. Pagefind exposes these custom properties
     for exactly this; they follow the scheme. -->
<style is:global>
  .note b {
    color: var(--color-text-primary);
    font-weight: 600;
  }
  #search {
    --pagefind-ui-scale: 1;
    --pagefind-ui-primary: var(--color-text-accent);
    --pagefind-ui-text: var(--color-text-primary);
    --pagefind-ui-background: var(--color-background-surface);
    --pagefind-ui-border: var(--color-border-emphasized);
    --pagefind-ui-tag: var(--color-background-surface);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 2px;
    --pagefind-ui-image-border-radius: 2px;
    --pagefind-ui-font: var(--font-family-body);
  }
  #search .pagefind-ui__search-input {
    font-family: var(--font-family-body);
    font-size: var(--text-body-size);
    font-weight: 400;
    color: var(--color-text-primary);
    background: var(--color-background-surface);
    border: 1px solid var(--color-border-emphasized);
    border-radius: 2px;
  }
  #search .pagefind-ui__search-input:focus-visible {
    outline: var(--focus-outline-width) solid var(--focus-outline-color);
    outline-offset: var(--focus-outline-offset);
  }
  #search .pagefind-ui__search-input::placeholder {
    color: var(--color-text-secondary);
    opacity: 1;
  }
  #search .pagefind-ui__form::before {
    background-color: var(--color-text-secondary);
    opacity: 1;
  }
  #search .pagefind-ui__search-clear {
    font-family: var(--font-family-body);
    font-size: var(--text-supporting-size);
    color: var(--ix-link);
    background: transparent;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }
  #search .pagefind-ui__search-clear:hover {
    color: var(--color-text-primary);
  }
  /* The count of results: a label, with the rule that opens the list under it. */
  #search .pagefind-ui__message {
    font-family: var(--font-family-body);
    font-size: var(--text-label-size);
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    height: auto;
    padding-block: var(--spacing-6) var(--spacing-3);
    border-block-end: var(--ix-rule);
  }
  #search .pagefind-ui__result {
    border-block-start: 0;
    border-block-end: var(--ix-hairline);
    padding-block: var(--spacing-4);
  }
  #search .pagefind-ui__result-title {
    font-family: var(--font-family-body);
    font-size: var(--text-body-size);
    line-height: 1.3;
    font-weight: 600;
  }
  #search .pagefind-ui__result-link {
    color: var(--ix-link);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }
  #search .pagefind-ui__result-link:hover {
    color: var(--color-text-primary);
  }
  #search .pagefind-ui__result-excerpt {
    font-family: var(--font-family-body);
    font-size: var(--text-supporting-size);
    line-height: var(--text-supporting-leading);
    color: var(--color-text-primary);
  }
  #search .pagefind-ui__result-nested {
    border-inline-start: var(--ix-hairline);
    padding-inline-start: var(--spacing-4);
  }
  /* A hit: a tint of ember under the text, which keeps its own colour. */
  #search mark {
    color: inherit;
    background: color-mix(in oklab, var(--ix-ember) 30%, transparent);
    border-radius: 2px;
    box-shadow: none;
  }
  #search .pagefind-ui__button {
    font-family: var(--font-family-body);
    font-size: var(--text-supporting-size);
    font-weight: 600;
    color: var(--color-text-primary);
    background: transparent;
    border: 1px solid var(--color-text-primary);
    border-radius: 2px;
    height: auto;
    min-height: var(--ix-control);
    padding: 0 var(--spacing-6);
  }
  #search .pagefind-ui__button:hover {
    background: var(--color-background-surface);
  }
</style>
