---
import BaseLayout from '@/layouts/BaseLayout.astro';
import EntryRow from '@/components/EntryRow.astro';
import RecentPosts from '@/components/RecentPosts.astro';
import TagChip from '@/components/TagChip.astro';
import { getLedger } from '@/lib/ledger';
import { blogLd, jsonLd } from '@/lib/display';

const { total, entries, tags, tagsUsedOnce } = await getLedger();

/* The front page is current: the newest posts. Everything else is one
   click away, in /blog/ and /archive/. */
const LIST = 10;
const listed = entries.slice(0, LIST);

/* The tag index: the head of a long tail, with the tail counted. */
const headTags = tags.filter((t) => t.count > 1);
const legacyYears = entries.filter((e) => e.post.data.tags.includes('legacy')).map((e) => e.date.getUTCFullYear());
---

<BaseLayout
  title="Coze - Arda Karaduman's blog"
  description="Notes by Arda Karaduman on AI tooling, Go, DevOps, home networking, and generative music. Published since 2010."
>
  <script type="application/ld+json" is:inline set:html={jsonLd(blogLd())} />

  <header class="page-head" lang="en">
    <h1 class="ix-emerge">Blog</h1>
    <p class="ix-lede">Notes on software and tools.</p>
  </header>

  <RecentPosts entries={entries} />

  <section class="block" lang="en">
    <div class="list-head">
      <h2 class="ix-label ix-label--ember">Posts</h2>
      <span class="ix-label">{listed.length} of {total}</span>
    </div>
    <ul class="ix-list">
      {listed.map((entry) => (
        <EntryRow
          slug={entry.slug}
          title={entry.post.data.title}
          date={entry.date}
          tags={entry.post.data.tags}
          no={entry.no}
          lang={entry.post.data.lang}
        />
      ))}
    </ul>
    <!-- data-key: single-key shortcuts (l, t here; a, / and r are in the bar). -->
    <nav class="more" aria-label="More">
      <a href="/blog/" data-key="l" aria-keyshortcuts="l">Older posts</a>
      <a href="#tags" data-key="t" aria-keyshortcuts="t">Tags</a>
      <a href="/rss.xml">RSS</a>
    </nav>
  </section>

  <!-- the tag index -->
  <section class="block" id="tags" lang="en">
    <div class="list-head">
      <h2 class="ix-label ix-label--ember">Tags</h2>
      <span class="ix-label">{tags.length} total · {tagsUsedOnce} used once</span>
    </div>
    <ul class="ix-chips">
      {headTags.map(({ tag, count }) => (
        <li><TagChip tag={tag} count={count} /></li>
      ))}
      <li><a class="ix-chip" href="/blog/">+{tagsUsedOnce} <span class="chip-n">used once</span></a></li>
    </ul>
    {legacyYears.length > 0 && (
      <p class="ix-note ix-small tag-note"><b>legacy</b> marks posts from {Math.min(...legacyYears)} to {Math.max(...legacyYears)}.</p>
    )}
  </section>
</BaseLayout>
