---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Not Found - Coze" noindex>
  <div class="page-head" lang="en">
    <p class="ix-mono">404 · Missing entry</p>
    <h1>Not in this index</h1>
    <p class="ix-lede">
      No entry exists at this address. It may have moved, or it never existed.
    </p>
    <!-- data-key: single-key shortcuts (i here; a and / are in the bar). -->
    <nav class="more" aria-label="Where to next">
      <a href="/" data-key="i" aria-keyshortcuts="i">Blog</a>
      <a href="/archive/">Archive</a>
      <a href="/search/">Search</a>
    </nav>
  </div>
</BaseLayout>
