---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  keywords?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  lang?: string;
}

const { title, description = "Coze - Software Development Journey", image, keywords, type = 'website', publishedTime, lang = 'en' } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site).href : new URL('/images/og-image.jpg', Astro.site).href;
const ogLocale = lang === 'ja' ? 'ja_JP' : lang === 'tr' ? 'tr_TR' : 'en_US';
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#0a0908" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title="Coze Blog" href={new URL("rss.xml", Astro.site)} />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="me" href="https://mastodon.world/@arda" />

    <!-- Fonts (One Bit Forest): Big Shoulders Display for the masthead,
         Plex Sans / Mono / Serif for UI, meta and long-form reading, Plex
         Sans JP for the Japanese posts (Google serves it in unicode-range
         slices, so English pages download no CJK glyphs). Plex covers
         Latin Extended-A, so the Turkish posts' ğ ş İ stay in-face. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@700;800;900&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&family=IBM+Plex+Serif:ital,wght@0,400;0,600;1,400&family=IBM+Plex+Sans+JP:wght@400;500;600&display=swap" rel="stylesheet" />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Arda Karaduman" />
    {keywords && <meta name="keywords" content={keywords} />}

    <!-- Fediverse -->
    <meta name="fediverse:creator" content="@arda@mastodon.world" />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Coze — blog.arda.tr" />
    <meta property="og:locale" content={ogLocale} />
    {type === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@ardakaraduman" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Rendition boot: runs before paint to avoid a flash. Migrates any
         older id a returning visitor may still be carrying (The Weekly Page,
         Ink & Ledger and before) onto the rendition with the same role,
         otherwise follows the system preference (prefers-contrast → the AAA
         renditions); Night when the system states none. Keep the id list in
         step with src/components/ThemeToggle.astro. -->
    <script is:inline>
      (function () {
        var RENDITIONS = ['night', 'night-hc', 'xerox', 'xerox-hc'];
        var LEGACY = {
          pulp: 'xerox', 'pulp-hc': 'xerox-hc', beta: 'night', 'beta-hc': 'night-hc',
          dark: 'night', light: 'xerox', dracula: 'night',
          alucard: 'xerox', paper: 'xerox-hc', blade: 'night', 'dracula-pro': 'night',
          carbon: 'night-hc', buffy: 'night', lincoln: 'night', morbius: 'night',
          'van-helsing': 'night'
        };
        var COLORS = { night: '#0a0908', 'night-hc': '#000000', xerox: '#efede6', 'xerox-hc': '#ffffff' };
        var stored = null;
        try { stored = localStorage.getItem('theme'); } catch (e) {}
        if (stored && LEGACY[stored]) stored = LEGACY[stored];
        var rendition = stored;
        if (!rendition || RENDITIONS.indexOf(rendition) === -1) {
          var hc = matchMedia('(prefers-contrast: more)').matches;
          var light = !matchMedia('(prefers-color-scheme: dark)').matches &&
            matchMedia('(prefers-color-scheme: light)').matches;
          rendition = light ? (hc ? 'xerox-hc' : 'xerox') : (hc ? 'night-hc' : 'night');
        }
        document.documentElement.classList.add(rendition);
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta && COLORS[rendition]) meta.setAttribute('content', COLORS[rendition]);
      })();
    </script>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <!-- The 1-bit engine and its wiring: dithered OG images, treeline, clock. -->
    <script>
      import '@/scripts/site.js';
    </script>
    <!-- Cloudflare Web Analytics (cookieless). is:inline keeps the beacon verbatim
         so Astro doesn't bundle it or drop the data-cf-beacon attribute. -->
    <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "bd17608cad3d493a941bb5738f6f645f"}'></script>
    <!-- End Cloudflare Web Analytics -->
  </body>
</html>
