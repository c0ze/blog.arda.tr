---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { bootSnippet } from '@/brand/scheme.js';

interface Props {
  title: string;
  description?: string;
  image?: string;
  keywords?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  lang?: string;
  /** Keep the page out of search indexes (the 404): adds robots noindex, drops the canonical. */
  noindex?: boolean;
}

const { title, description = "Notes by Arda Karaduman on AI tooling, Go, DevOps, home networking, and generative music. Published since 2010.", image, keywords, type = 'website', publishedTime, lang = 'en', noindex = false } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const DEFAULT_OG_IMAGE = '/images/og-image.jpg';
const ogImage = new URL(image || DEFAULT_OG_IMAGE, Astro.site).href;
// The default image is square (1024×1024): a large-image card would crop it.
const twitterCard = !image || image === DEFAULT_OG_IMAGE ? 'summary' : 'summary_large_image';
const JP_FONT = 'https://fonts.googleapis.com/css2?family=Zen+Antique&display=swap';
const ogLocale = lang === 'ja' ? 'ja_JP' : lang === 'tr' ? 'tr_TR' : 'en_US';
---

<!DOCTYPE html>
<html lang={lang} data-astryx-theme="arda" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Bone paper unless the visitor pinned dark. The family's boot snippet
         (src/brand/scheme.js, localStorage key "theme", fallback "light") puts
         the scheme on <html> before first paint and rewrites an old stored
         rendition id to light or dark. It must directly follow the meta. -->
    <meta name="color-scheme" content="light" />
    <script is:inline set:html={bootSnippet('theme', 'light')} />
    <meta name="theme-color" content="#E8E0CE" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalURL} />}
    <link rel="alternate" type="application/rss+xml" title="Coze Blog" href={new URL("rss.xml", Astro.site)} />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="me" href="https://mastodon.world/@arda" />

    <!-- Fonts (Kara Duman): Grenze Gotisch for names (page and post titles),
         Spectral for everything else, JetBrains Mono for dates and code, Zen
         Antique for the Japanese posts and titles (Google serves it in
         unicode-range slices, so English pages download no CJK glyphs).
         Grenze Gotisch and Spectral cover Latin Extended-A, so the Turkish
         posts' ğ ş İ stay in-face.
         The Zen Antique stylesheet is most of the CSS (its @font-face
         slices), so it has its own <link>: render-blocking only on `ja`
         pages, loaded without blocking everywhere else. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Grenze+Gotisch:wght@700;800;900&family=JetBrains+Mono:wght@400;700&family=Spectral:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet" />
    {lang === 'ja' ? (
      <link href={JP_FONT} rel="stylesheet" />
    ) : (
      <>
        <link href={JP_FONT} rel="stylesheet" media="print" onload="this.media='all'" />
        <noscript><link href={JP_FONT} rel="stylesheet" /></noscript>
      </>
    )}

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Arda Karaduman" />
    {keywords && <meta name="keywords" content={keywords} />}

    <!-- Fediverse -->
    <meta name="fediverse:creator" content="@arda@mastodon.world" />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Coze · blog.arda.tr" />
    <meta property="og:locale" content={ogLocale} />
    {type === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {!noindex && <meta property="og:url" content={canonicalURL} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:site" content="@ardakaraduman" />
    {!noindex && <meta name="twitter:url" content={canonicalURL} />}
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <a class="ix-sr ix-label skip-link" href="#content" lang="en">Skip to content</a>
    <Header />
    <main id="content" class="ix-wrap ix-wrap--read">
      <slot />
    </main>
    <Footer />
    <!-- The scheme switch and the single-key shortcuts. -->
    <script>
      import '@/scripts/site.js';
    </script>
    <!-- Cloudflare Web Analytics (cookieless). is:inline keeps the beacon verbatim
         so Astro doesn't bundle it or drop the data-cf-beacon attribute. -->
    <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "bd17608cad3d493a941bb5738f6f645f"}'></script>
    <!-- End Cloudflare Web Analytics -->
  </body>
</html>
