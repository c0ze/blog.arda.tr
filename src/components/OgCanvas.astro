---
/**
 * A post's OG image, shown as a live 1-bit canvas (src/scripts/site.js wakes
 * it with onebit's dithered() once it nears the viewport). Without script the
 * <noscript> <img> shows the plain image instead.
 *
 * `alt` given → the canvas is announced as an image; omitted → decorative
 * (list thumbnails sit next to their own title, so a label would be noise).
 * A post without an image dithers a sigil seeded by its slug; its no-script
 * fallback is the site's default OG image.
 */
interface Props {
  src?: string;
  seed: string;
  alt?: string;
  /** CSS px per 1-bit pixel. */
  px?: number;
  contrast?: number;
  class?: string;
  /** The post page's cover: develop as 1-bit, then burn off to the real image underneath. */
  reveal?: boolean;
}

const { src, seed, alt, px = 2, contrast, class: cls = '', reveal = false } = Astro.props;
const image = src && src.trim() ? src.trim() : '';
// only a real image has something to reveal; a sigil stays 1-bit
const revealing = reveal && image !== '';
---

<div class={`og ${revealing ? 'og--reveal' : ''} ${cls}`.trim()}>
  {revealing && <img class="og__real" src={image} alt={alt ?? ''} decoding="async" fetchpriority="high" />}
  <canvas
    class="px"
    data-og={image}
    data-seed={seed}
    data-px={px}
    data-contrast={contrast}
    data-reveal={revealing ? '' : undefined}
    role={alt && !revealing ? 'img' : undefined}
    aria-label={revealing ? undefined : alt}
    aria-hidden={alt && !revealing ? undefined : 'true'}
  ></canvas>
  {revealing
    ? <noscript><style>{'.og--reveal .og__real { visibility: visible; }'}</style></noscript>
    : <noscript><img src={image || '/images/og-image.jpg'} alt={alt ?? ''} loading="lazy" decoding="async" /></noscript>}
</div>
