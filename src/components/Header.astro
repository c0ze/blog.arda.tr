---
import ThemeToggle from './ThemeToggle.astro';
import { getLedger } from '@/lib/ledger';

const { total, firstYear } = await getLedger();

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const navLinks = [
  { href: '/', label: 'index', current: pathname === '/' },
  { href: '/archive', label: 'archive', current: pathname === '/archive' },
  { href: '/search', label: 'search', current: pathname === '/search' },
  { href: '/#tags', label: 'tags', current: false },
  { href: '/rss.xml', label: 'rss', current: false },
];
---

<!-- lang="en" on the chrome: a Turkish post sets <html lang="tr">, and the
     chrome is English wherever the post is not (uppercase follows lang). -->
<header class="bar" lang="en">
  <a class="bar__site" href="/" aria-label="Coze — blog.arda.tr, home"><i aria-hidden="true"></i>blog.arda.tr</a>
  <nav aria-label="Primary">
    {navLinks.map((link) => (
      <a href={link.href} aria-current={link.current ? 'page' : undefined}>{link.label}</a>
    ))}
  </nav>
  <span class="bar__sp"></span>
  <span class="bar__stat">{total} entries · since {firstYear}</span>
  <span class="bar__clock" data-clock hidden></span>
  <ThemeToggle />
</header>
