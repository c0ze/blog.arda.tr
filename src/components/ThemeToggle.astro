---
/**
 * The rendition switch, in the status bar. A <details> disclosure, so it opens
 * without script; the summary names the current rendition through CSS
 * (.rend__cur in global.css), so it is right before any script runs.
 *
 * Four renditions, in menu order — the family ids (DESIGN-SYSTEM.md):
 * Night (default), Night HC, Xerox, Xerox HC. The two HC renditions target
 * WCAG AAA. The id list is duplicated in the boot script in BaseLayout.astro
 * and in scripts/check-theme-contract.mjs; keep them in step.
 */
const renditions = [
  { id: 'night', name: 'Night', role: 'dark', hint: 'dark' },
  { id: 'night-hc', name: 'Night HC', role: 'hc-dark', hint: 'high contrast dark' },
  { id: 'xerox', name: 'Xerox', role: 'light', hint: 'light' },
  { id: 'xerox-hc', name: 'Xerox HC', role: 'hc-light', hint: 'high contrast light' },
];
---

<details class="rend">
  <summary aria-label="Rendition"><span class="rend__cur"></span> ▾</summary>
  <div class="corner" role="group" aria-label="Rendition">
    {renditions.map((r) => (
      <button
        type="button"
        class="corner__btn"
        data-rendition={r.id}
        aria-pressed="false"
        title={`${r.name} (${r.hint})`}
      >{r.name.toLowerCase()}<em>{r.hint}</em></button>
    ))}
  </div>
</details>

<script is:inline>
(function () {
  var RENDITIONS = ['night', 'night-hc', 'xerox', 'xerox-hc'];
  var COLORS = { night: '#0a0908', 'night-hc': '#000000', xerox: '#efede6', 'xerox-hc': '#ffffff' };
  // Returning visitors carry an older id (The Weekly Page, Ink & Ledger, and
  // before); land them on the rendition with the same role.
  var LEGACY = {
    pulp: 'xerox', 'pulp-hc': 'xerox-hc', beta: 'night', 'beta-hc': 'night-hc',
    dark: 'night', light: 'xerox', dracula: 'night',
    alucard: 'xerox', paper: 'xerox-hc', blade: 'night', 'dracula-pro': 'night',
    carbon: 'night-hc', buffy: 'night', lincoln: 'night', morbius: 'night',
    'van-helsing': 'night'
  };

  function current() {
    var stored = null;
    try { stored = localStorage.getItem('theme'); } catch (e) {}
    if (stored && LEGACY[stored]) stored = LEGACY[stored];
    if (stored && RENDITIONS.indexOf(stored) !== -1) return stored;
    for (var i = 0; i < RENDITIONS.length; i++) {
      if (document.documentElement.classList.contains(RENDITIONS[i])) return RENDITIONS[i];
    }
    return 'night';
  }

  function apply(rendition) {
    RENDITIONS.forEach(function (r) { document.documentElement.classList.remove(r); });
    document.documentElement.classList.add(rendition);
    try { localStorage.setItem('theme', rendition); } catch (e) {}
    var meta = document.querySelector('meta[name="theme-color"]');
    if (meta && COLORS[rendition]) meta.setAttribute('content', COLORS[rendition]);
    sync(rendition);
  }

  function sync(rendition) {
    document.querySelectorAll('[data-rendition]').forEach(function (btn) {
      btn.setAttribute('aria-pressed', String(btn.getAttribute('data-rendition') === rendition));
    });
  }

  function init() {
    sync(current());
    document.querySelectorAll('.corner').forEach(function (group) {
      if (group.hasAttribute('data-init')) return;
      group.setAttribute('data-init', 'true');
      group.querySelectorAll('[data-rendition]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          apply(btn.getAttribute('data-rendition'));
          var menu = btn.closest ? btn.closest('details') : null;
          if (menu) menu.open = false;
        });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>
