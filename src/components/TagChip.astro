---
import { tagHref } from '@/lib/display';

interface Props {
  tag: string;
  /** Shown dimmed after the name. */
  count?: number;
  active?: boolean;
}

const { tag, count, active = false } = Astro.props;
---

<a class={`chip${active ? ' chip--on' : ''}`} href={tagHref(tag)} aria-current={active ? 'true' : undefined}>
  {tag}{count !== undefined && <em>{count}</em>}
</a>
