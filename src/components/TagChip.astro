---
import { tagHref } from '@/lib/display';

interface Props {
  tag: string;
  /** Shown after the name. */
  count?: number;
  /** A post's own tag: bone on moss. Without it the chip is an outlined link. */
  moss?: boolean;
}

const { tag, count, moss = false } = Astro.props;
---

<a class:list={['ix-chip', moss && 'ix-chip--tag']} href={tagHref(tag)}>
  {tag}{count !== undefined && <span class="chip-n">{count}</span>}
</a>
